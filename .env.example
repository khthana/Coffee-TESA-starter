# Copy to .env and fill in. Never commit .env.

# Market (sandbox before the competition, the real market on competition day)
MARKET_URL=http://localhost:8000
TEAM_KEY=sk-T01-change-me

# LLM: any OpenAI-compatible server (event LLM gateway, Ollama on your laptop, OpenAI)
USE_LLM=1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:9b
LLM_API_KEY=none
LLM_TIMEOUT=60
# 1 = let the model "think" first. Smarter but much slower, and it can run out of tokens.
LLM_THINKING=0
