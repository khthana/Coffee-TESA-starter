# Copy to .env and fill in. Never commit .env.

# Market (sandbox before the competition, the real market on competition day)
MARKET_URL=http://localhost:8000
TEAM_KEY=sk-T01-change-me

# LLM: any OpenAI-compatible server. Competition (stages 2-3): ONLY the event LLM gateway is allowed --
# any other LLM (cloud, or Ollama on your laptop) = disqualified. Ollama on your laptop is fine for practice.
USE_LLM=1
# Event LLM gateway: the address staff announce in the room; the key is the same as TEAM_KEY
LLM_BASE_URL=http://GATEWAY-ADDRESS:4000/v1
LLM_MODEL=event-llm
LLM_API_KEY=sk-T01-change-me
# Practice only (not in the competition): Ollama on your laptop
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3.5:4b
# LLM_API_KEY=none
LLM_TIMEOUT=60
# 1 = let the model "think" first. Smarter but much slower, and it can run out of tokens.
LLM_THINKING=0
